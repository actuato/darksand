{
  "version": "darksand-mission.v1",
  "name": "wharf-inspection",
  "disposition": "Clear",
  "optimality": "MinExpectedCost",
  "costs": {
    "init": 1.0,
    "ensure-ready": 2.0,
    "bounded-leg": 5.0,
    "confirm": 1.0
  },
  "goal": {
    "dnf": [
      [
        {
          "key": "phase",
          "expected": "done"
        }
      ]
    ]
  },
  "root": {
    "type": "Sequence",
    "name": "mission",
    "children": [
      {
        "type": "SetBlackboard",
        "name": "init",
        "key": "phase",
        "value": "starting"
      },
      {
        "type": "Retry",
        "name": "ensure-ready",
        "max_retries": 2,
        "child": {
          "type": "CheckBlackboard",
          "name": "check-phase",
          "key": "phase",
          "expected": "starting"
        }
      },
      {
        "type": "Timeout",
        "name": "bounded-leg",
        "timeout_ms": 5000,
        "child": {
          "type": "SetBlackboard",
          "name": "arrive",
          "key": "phase",
          "value": "on-station"
        }
      },
      {
        "type": "Selector",
        "name": "confirm",
        "children": [
          {
            "type": "CheckBlackboard",
            "name": "already-done",
            "key": "phase",
            "expected": "done"
          },
          {
            "type": "SetBlackboard",
            "name": "mark-done",
            "key": "phase",
            "value": "done"
          }
        ]
      }
    ]
  }
}
